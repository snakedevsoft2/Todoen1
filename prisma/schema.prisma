// Prisma schema - TODO EN UNO
// Multi-negocio: cada usuario tiene su propio negocio y sus datos estan aislados.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BusinessType {
  BARBERIA
  RESTAURANTE
  COMIDAS_RAPIDAS
  ROPA
  /// Presta plata y la cobra por cuotas. No vende nada: su dia es saber a
  /// quien le toca pagar hoy y quien se atraso.
  CARTERA
  /// No vende: administra personal. Los empleados marcan entrada y salida
  /// desde su propio telefono y el dueno saca la planilla y los reportes.
  ASISTENCIA
  /// Para el negocio que no encaja en los otros. Arranca con todo lo que no
  /// depende de un oficio en particular y el dueno apaga lo que le sobre
  /// desde "Armar mi menu".
  OTRO
}

/// Cada cuanto se cobra una cuota del prestamo.
enum LoanFrequency {
  DIARIA
  SEMANAL
  QUINCENAL
  MENSUAL
}

enum StaffRole {
  DUENO
  BARBERO
  /// Empleado de la tienda de ropa: vende y ve el movimiento, no la configuracion.
  VENDEDOR
}

enum AppointmentStatus {
  PENDIENTE
  CONFIRMADO
  ATENDIDO
  CANCELADO
  NO_ASISTIO
}

enum OrderStatus {
  ABIERTA
  PAGADA
  CANCELADA
}

enum PaymentMethod {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
  OTRO
}

enum SaleOrigin {
  MANUAL
  TURNO
  ORDEN
  /// Abono de una deuda que todavia no se habia registrado como venta.
  CARTERA
}

enum DebtStatus {
  PENDIENTE
  PAGADA
  ANULADA
}

/// Por que se movio el stock. VENTA y DEVOLUCION los pone la aplicacion sola.
enum StockMoveType {
  ENTRADA
  SALIDA
  AJUSTE
  VENTA
  DEVOLUCION
}

/// Un usuario = un negocio = un espacio de trabajo aislado.
model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  ownerName    String
  businessName String
  businessType BusinessType
  slug         String       @unique
  phone        String?
  address      String?

  // Personalizacion de marca
  logo       String? // imagen del logo guardada como data URL
  brandColor String  @default("#2563eb")
  theme      String  @default("claro") // "claro" u "oscuro"
  tagline    String? // frase corta para la pagina publica

  // Portafolio publico: la pagina que el negocio comparte por enlace o QR.
  /// Si esta apagado, la pagina publica responde que no esta disponible.
  publicOpen       Boolean @default(true)
  /// Titular grande de la pagina. Si esta vacio usamos el nombre del negocio.
  publicHeadline   String?
  /// Parrafo de presentacion.
  publicAbout      String?
  /// Foto de portada, guardada como data URL igual que el logo.
  publicCover      String?
  /// Nota que sale junto al boton de pedir (horarios, domicilios, condiciones).
  publicOrderNote  String?
  /// Si se muestran los precios. Hay negocios que prefieren no publicarlos.
  publicShowPrices Boolean @default(true)
  /// Fondo de la pagina publica, como una pagina de pagos: "claro" es la de
  /// siempre; los demas ponen un fondo solido (o la portada difuminada) y el
  /// contenido flota encima en una tarjeta. Ver lib/fondos.ts.
  publicBackground String  @default("claro")

  // Promociones al por mayor: el apartado del catalogo para quien compra en cantidad.
  /// Si esta encendido, el catalogo publico muestra las escalas por cantidad.
  wholesaleOpen  Boolean @default(false)
  /// Condiciones del mayorista (pedido minimo, forma de pago, despachos).
  wholesaleNote  String?
  /// Titulo del apartado. Si esta vacio usamos "Precios al por mayor".
  wholesaleTitle String?

  // Avisos por WhatsApp cuando un cliente separa turno
  whatsappNumber   String? // numero que recibe los avisos, solo digitos con indicativo
  whatsappProvider String  @default("enlace") // "enlace", "callmebot" o "meta"
  whatsappApiKey   String? // clave de CallMeBot o token de Meta
  whatsappPhoneId  String? // identificador del numero en Meta
  notifyOnBooking  Boolean @default(true)

  // Configuracion de agenda / caja
  currency    String  @default("COP")
  timezone    String  @default("America/Bogota")
  openHour    Int     @default(9) // 9 = 9:00 am
  closeHour   Int     @default(20) // 20 = 8:00 pm
  slotMinutes Int     @default(30)
  workDays    String  @default("1,2,3,4,5,6") // 1=lunes ... 7=domingo
  bookingOpen Boolean @default(true)

  /**
   * Cuenta suspendida por el administrador de la plataforma.
   * Mientras este puesta, nadie de esta cuenta puede entrar. No se borra nada:
   * suspender es cerrar la puerta, no botar la casa.
   */
  suspendedAt     DateTime?
  suspendedReason String?

  /**
   * Pregunta de seguridad, para recuperar la clave sin depender del correo.
   * La respuesta se guarda con bcrypt, igual que la contrasena, y normalizada
   * (sin tildes, sin mayusculas, sin espacios de sobra): "  Bogotá" y "bogota"
   * son la misma respuesta, porque nadie recuerda como la escribio.
   */
  securityQuestion   String?
  securityAnswerHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff          Staff[]
  accountModules AccountModule[]
  services       Service[]
  appointments   Appointment[]
  sales          Sale[]
  expenses       Expense[]
  orders         Order[]
  cashClosures   CashClosure[]
  notifications  Notification[]
  variants       ProductVariant[]
  stockMoves     StockMove[]
  suppliers      Supplier[]
  debts          Debt[]
  debtPayments   DebtPayment[]
  orderItems     OrderItem[]
  saleItems      SaleItem[]
  workspaces     WorkspaceConfig[]
  moduleEvents   ModuleEvent[]
  wholesaleTiers WholesaleTier[]
  passwordResets PasswordReset[]
  sites          WorkSite[]
  attendance     Attendance[]
  visitReports   VisitReport[]
  visitPhotos    VisitPhoto[]
  customers      Customer[]
  customerTags   CustomerTag[]
  deals          Deal[]
  followUps      FollowUp[]
  interactions   Interaction[]
  agentConfig        AgentConfig?
  agentConversations AgentConversation[]
  agentMessages      AgentMessage[]
  novelties          Novelty[]

  @@index([slug])
}

/// Una escala de precio al por mayor: desde cuantas unidades y con cuanto descuento.
///
/// El descuento se guarda en porcentaje y no en precio fijo a proposito: asi
/// sirve para todo el catalogo de una vez y no hay que volver a tocarlo cada
/// vez que sube el precio de una prenda.
model WholesaleTier {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Desde cuantas unidades en el pedido arranca esta escala.
  minQty     Int
  /// Cuanto se le descuenta a cada unidad, de 1 a 90.
  percentOff Int
  /// Nombre opcional de la escala ("Media docena", "Paca").
  label      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Una sola escala por cantidad: dos "desde 6" no sabrian cual gana.
  @@unique([userId, minQty])
  @@index([userId])
}

/// Plata que le deben al negocio. Un fiado, un abono pendiente, una cuota.
model Debt {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientName  String
  clientPhone String?
  concept     String
  /// Total de la deuda. Lo que falta sale de restarle los abonos.
  amount      Int
  /// Desde cuando debe, en "YYYY-MM-DD".
  day         String
  /// Proximo vencimiento. Vacio si no se acordo fecha.
  dueDay      String?
  status      DebtStatus @default(PENDIENTE)
  notes       String?

  /**
   * Si la venta ya se registro en Ventas cuando se entrego la mercancia.
   * Decide si los abonos entran a la caja del dia: si la venta ya se conto,
   * cobrar es recuperar plata que ya estaba sumada, y volverla a sumar seria
   * contar doble. Si no se conto (el fiado tipico), cada abono si es venta
   * del dia en que se recibe.
   */
  alreadyInvoiced Boolean @default(false)

  /// Cuando se le mando el ultimo cobro, para no acosar al cliente.
  lastReminderAt DateTime?

  /**
   * Datos del prestamo, para el negocio de cartera.
   * Van aqui y no en una tabla aparte a proposito: una deuda con cuotas sigue
   * siendo una deuda, y asi los abonos, la caja, los reportes y los
   * recordatorios que ya existen le sirven igual sin tocarlos.
   * OJO con `amount`: sigue siendo el TOTAL a pagar (capital + interes). Es lo
   * que se cobra y de lo que se restan los abonos. `principal` es solo cuanto
   * salio del bolsillo, que es otra cosa y sirve para saber que se gano.
   * Van todos opcionales porque un fiado de tienda no tiene ni interes ni
   * cuotas: ahi solo se llena `amount`.
   */
  /// Cuanto se le presto, sin el interes.
  principal    Int?
  /// Interes sobre el capital, en porcentaje. 20 = 20%.
  interestPct  Int?
  /// En cuantas cuotas se pactó.
  installments Int?
  /// Cada cuanto cae una cuota.
  frequency    LoanFrequency?

  /**
   * El fiador: quien responde si el deudor no paga.
   * Se guarda con cedula y direccion porque sin eso no se le puede ubicar, que
   * es justo para lo que existe la figura.
   */
  guarantorName    String?
  guarantorId      String?
  guarantorPhone   String?
  guarantorAddress String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments DebtPayment[]

  @@index([userId, status])
  @@index([userId, dueDay])
}

/// Cada abono que el cliente hace sobre su deuda.
model DebtPayment {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  debtId String
  debt   Debt   @relation(fields: [debtId], references: [id], onDelete: Cascade)

  amount Int
  day    String // "YYYY-MM-DD"
  method PaymentMethod @default(EFECTIVO)
  notes  String?
  /// Venta que genero este abono, cuando la deuda no estaba facturada.
  saleId String?

  createdAt DateTime @default(now())

  @@index([debtId])
  @@index([userId, day])
}

/// A quien le compra el negocio. Sirve para saber a quien pedirle y a como.
model Supplier {
  id      String  @id @default(cuid())
  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name    String
  /// Persona con la que se habla, si no es el mismo negocio.
  contact String?
  phone   String?
  notes   String?
  active  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services Service[]
  moves    StockMove[]

  @@index([userId, active])
}

/// Persona que atiende en el negocio (barberos). Puede tener su propio usuario
/// para entrar a la aplicacion, pero siempre trabaja dentro del mismo negocio.
model Staff {
  id           String  @id @default(cuid())
  userId       String
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  /// Correo con el que entra a la aplicacion. Si esta vacio, no tiene acceso.
  email        String? @unique
  passwordHash String?

  /**
   * Pregunta de seguridad, para recuperar la clave sin depender del correo.
   * La respuesta se guarda con bcrypt, igual que la contrasena, y normalizada
   * (sin tildes, sin mayusculas, sin espacios de sobra): "  Bogotá" y "bogota"
   * son la misma respuesta, porque nadie recuerda como la escribio.
   */
  securityQuestion   String?
  securityAnswerHash String?
  phone              String?
  /// Foto de perfil, achicada en el telefono y guardada como data URL. Se
  /// sirve en /foto-perfil/[id], solo a gente del mismo negocio.
  photo              String?
  role               StaffRole @default(BARBERO)
  /// Color para reconocerlo de un vistazo en la agenda.
  color              String    @default("#0ea5e9")
  /// Porcentaje que se lleva de lo que cobra. Solo para el reporte.
  commissionPct      Int       @default(0)
  /// Aparece en la pagina publica para que el cliente lo elija.
  bookable           Boolean   @default(true)
  active             Boolean   @default(true)
  /// Cuando termino (o salto) el instructivo de bienvenida. Va por persona y
  /// no por negocio: cada empleado nuevo lo ve la primera vez que entra.
  tourDoneAt         DateTime?

  /// Hasta que paso llego el asistente de bienvenida, para poder retomarlo
  /// donde lo dejo en vez de volver a empezar.
  onboardingStep Int @default(0)

  /// Cuando lo termino o lo salto. Es lo mismo: ya decidio.
  onboardingDoneAt DateTime?

  /// Ultima vez que se le vio actividad. Se escribe cada tanto, no en cada
  /// pantalla: sirve para saber quien sigue usando la aplicacion, no para
  /// cronometrar a nadie.
  lastSeenAt DateTime?

  /**
   * ANTIGUO. La configuracion ahora vive en WorkspaceConfig. Estas dos
   * columnas se conservan porque en produccion puede haber gente que ya
   * configuro su menu antes del cambio: el sembrador las lee una vez y las
   * pasa a la tabla nueva. Nadie mas debe escribir aqui.
   * El espacio de trabajo de esta persona: que apartados esconde y en que
   * orden quiere el resto.
   * Va por persona y no por negocio a proposito: el dueno quiere ver reportes
   * y proveedores, y al que solo vende le estorban. Se guardan las direcciones
   * separadas por coma, que no llevan comas nunca.
   */
  navHidden String?
  navOrder  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]
  sales        Sale[]
  workspace    WorkspaceConfig?

  passwordResets PasswordReset[]
  marks          Attendance[]    @relation("MarcajesDeLaPersona")
  deals          Deal[]          @relation("OportunidadesDeLaPersona")
  followUps      FollowUp[]      @relation("SeguimientosDeLaPersona")
  novelties      Novelty[]       @relation("NovedadesDeLaPersona")

  @@index([userId, active])
}

/// Servicios (cortes) o productos (platos, bebidas...) que el negocio vende.
model Service {
  id          String  @id @default(cuid())
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Int // en unidades enteras de la moneda (ej: pesos)
  cost        Int     @default(0) // costo interno opcional
  durationMin Int     @default(30) // usado por la agenda de barberia
  category    String  @default("General")
  bookable    Boolean @default(true) // aparece en la reserva publica
  active      Boolean @default(true)

  // Tienda de ropa
  /// Foto de la prenda guardada como data URL, igual que el logo.
  image      String?
  /// Marca o proveedor de la prenda. Solo informativo.
  brand      String?
  /// Si es true, la prenda se vende por tallas y descuenta stock al vender.
  trackStock Boolean   @default(false)
  /// Aparece en el catalogo publico /catalogo/[slug].
  showcase   Boolean   @default(true)
  /// A quien se le compra esta prenda.
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]
  saleItems    SaleItem[]
  orderItems   OrderItem[]
  variants     ProductVariant[]

  @@index([userId, active])
}

/// Una talla y color concretos de una prenda. Es lo que de verdad tiene stock.
///
/// Guardamos userId aparte del serviceId a proposito: asi cada consulta de
/// inventario filtra directo por el negocio de la sesion, sin pasar por el
/// producto, y nadie puede tocar el stock de otro negocio.
model ProductVariant {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  size  String  @default("Unica")
  color String  @default("Unico")
  sku   String?

  stock    Int     @default(0)
  minStock Int     @default(0)
  /// Precio propio de esta talla. Si es null se usa el precio del producto.
  price    Int?
  /// Lo que costo la ultima entrada, para valorizar el inventario.
  cost     Int     @default(0)
  active   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  moves     StockMove[]
  saleItems SaleItem[]

  @@unique([serviceId, size, color])
  @@index([userId, active])
}

/// Historial de cada movimiento de stock. Nunca se edita: solo se agrega.
model StockMove {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  type       StockMoveType
  /// Cuanto cambio el stock: positivo entra, negativo sale.
  delta      Int
  /// Como quedo el stock despues del movimiento.
  stockAfter Int
  unitCost   Int           @default(0)
  reason     String?
  day        String // "YYYY-MM-DD"
  saleId     String?
  /// De quien vino la mercancia. Solo tiene sentido en las entradas, y es lo
  /// que permite saber despues a quien le compras cada prenda y a como.
  supplierId String?
  supplier   Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId, day])
  @@index([variantId, createdAt])
  @@index([supplierId])
}

/// Turno reservado por el cliente (barberia).
model Appointment {
  id             String            @id @default(cuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceId      String?
  service        Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceName    String // copia del nombre por si el servicio se borra
  staffId        String?
  staff          Staff?            @relation(fields: [staffId], references: [id], onDelete: SetNull)
  staffName      String? // copia del nombre del barbero por si se borra
  price          Int               @default(0)
  clientName     String
  clientPhone    String
  day            String // "YYYY-MM-DD"
  startTime      String // "HH:mm"
  endTime        String // "HH:mm"
  status         AppointmentStatus @default(PENDIENTE)
  notes          String?
  /// El cliente pidio que le recuerden su turno por WhatsApp. Lo elige el al
  /// reservar: es su telefono, no el del negocio.
  wantsReminder  Boolean           @default(true)
  /// Cuando se le mando el recordatorio, para no mandarlo dos veces.
  reminderSentAt DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  sale Sale?

  @@unique([userId, staffId, day, startTime])
  @@index([userId, day])
  @@index([userId, staffId, day])
}

/// Cuenta abierta / mesa / pedido (restaurante y comidas rapidas).
model Order {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String // "Mesa 4", "Domicilio 12", "Mostrador"
  day       String // "YYYY-MM-DD"
  status    OrderStatus @default(ABIERTA)
  notes     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  items OrderItem[]
  sale  Sale?

  @@index([userId, status])
  @@index([userId, day])
}

model OrderItem {
  id        String   @id @default(cuid())
  /// Duplicado del dueno de la cuenta a proposito: asi el aislamiento vive en
  /// la fila y no depende de que cada consulta se acuerde de pasar por el padre.
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  name      String
  unitPrice Int
  qty       Int      @default(1)
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([userId])
}

/// Venta cerrada. Es la fuente de verdad del dinero del dia.
model Sale {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  day           String // "YYYY-MM-DD" en la zona del negocio
  total         Int
  paymentMethod PaymentMethod @default(EFECTIVO)
  origin        SaleOrigin    @default(MANUAL)
  clientName    String?
  notes         String?
  staffId       String?
  staff         Staff?        @relation(fields: [staffId], references: [id], onDelete: SetNull)
  appointmentId String?       @unique
  appointment   Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  orderId       String?       @unique
  order         Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())

  items SaleItem[]

  @@index([userId, day])
  @@index([userId, staffId, day])
}

model SaleItem {
  id           String          @id @default(cuid())
  /// Mismo motivo que en OrderItem: el aislamiento va en la fila, no en la
  /// disciplina de quien escribe la consulta.
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  saleId       String
  sale         Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  serviceId    String?
  service      Service?        @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  /// Talla y color vendidos, cuando el producto lleva inventario.
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  /// Copia de "M / Negro" por si la talla se borra despues.
  variantLabel String?
  name         String
  unitPrice    Int
  qty          Int             @default(1)

  @@index([saleId])
  @@index([variantId])
  @@index([userId])
}

/// Gastos del dia (insumos, arriendo, domicilios...).
model Expense {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day         String // "YYYY-MM-DD"
  description String
  amount      Int
  category    String   @default("General")
  createdAt   DateTime @default(now())

  @@index([userId, day])
}

/// Cierre de caja del dia.
model CashClosure {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day           String // "YYYY-MM-DD"
  openingAmount Int      @default(0)
  totalSales    Int
  totalCash     Int
  totalCard     Int
  totalTransfer Int
  totalOther    Int      @default(0)
  totalExpenses Int
  netTotal      Int
  salesCount    Int
  countedCash   Int      @default(0)
  difference    Int      @default(0)
  notes         String?
  closedAt      DateTime @default(now())

  @@unique([userId, day])
  @@index([userId, day])
}

enum NotificationStatus {
  ENVIADO
  FALLIDO
  SIN_CONFIGURAR
}

/// Historial de avisos por WhatsApp, para que el dueno sepa si llegaron.
model Notification {
  id            String             @id @default(cuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel       String             @default("whatsapp")
  provider      String             @default("enlace")
  toNumber      String
  message       String
  status        NotificationStatus
  detail        String?
  appointmentId String?
  createdAt     DateTime           @default(now())

  @@index([userId, createdAt])
}

/// Categoria del modulo, para agrupar el configurador en bloques legibles.
enum ModuleGroup {
  /// Lo que no se puede esconder: resumen, ajustes y soporte.
  FIJO
  /// El apartado propio del oficio: turnos, cuentas abiertas, inventario.
  NUCLEO
  /// Plata: ventas, gastos, cartera, caja, catalogo, proveedores.
  DINERO
  /// Lo que trae mas clientes: portafolio, reportes, asistente, avisos.
  CRECIMIENTO
  /// Equipo, marca y el armador del menu.
  CONFIGURACION
}

/**
 * Catalogo maestro de apartados.
 * Antes esta lista vivia en src/lib/nav.ts. Vive en la base para que el
 * configurador pueda leerla, para poder describir cada apartado con palabras
 * que el cliente entienda, y para estrenar apartados sin volver a desplegar.
 */
model Module {
  /// Nombre corto y estable, ej "turnos". Es la llave que se guarda en la
  /// configuracion de cada persona: la direccion puede cambiar, la llave no.
  key   String      @id
  href  String      @unique
  label String
  icon  String
  group ModuleGroup

  /// Una linea. Es lo que se lee en la tarjeta del configurador.
  shortDescription String
  /// Parrafo con el para que. Se lee al abrir el detalle o en la guia.
  longDescription  String

  /// No se puede esconder. Sin resumen no hay a donde volver, sin ajustes no
  /// se podria deshacer el menu, y soporte es a donde acude quien se trabo.
  fixed     Boolean @default(false)
  /// Configuracion del negocio: el empleado no lo ve aunque este encendido.
  ownerOnly Boolean @default(false)

  /// Si aparece en el menu lateral. "Armar mi menu" existe en el catalogo
  /// pero se llega por el pie del menu, no ocupando un renglon del menu.
  inSidebar Boolean @default(true)

  /**
   * Variable de entorno que el apartado necesita para funcionar.
   * Si esta puesta y falta la credencial, el apartado no se ofrece: mejor que
   * no aparezca a que aparezca y lleve a una pantalla rota.
   */
  requiresEnv String?

  /// Orden de respaldo cuando el tipo de negocio no dice otra cosa.
  sortOrder Int     @default(100)
  active    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businessTypes BusinessTypeModule[]
  accounts      AccountModule[]
}

/**
 * Que apartados le tocan a cada tipo de negocio.
 * Aqui vive la regla de que la agenda por hora es de barberia: si no hay fila
 * para ese tipo de negocio, el apartado no existe para el, ni apagado.
 * El tipo va como texto y no como enum a proposito: asi el catalogo puede
 * quedar listo para distribuidora, servicios y freelance sin abrirlos todavia
 * al registro.
 */
model BusinessTypeModule {
  id           String @id @default(cuid())
  businessType String
  moduleKey    String
  module       Module @relation(fields: [moduleKey], references: [key], onDelete: Cascade)

  /// Si viene encendido la primera vez. Lo que no todo el mundo usa (cartera,
  /// asistente, avisos) entra apagado para no llenar el menu de botones.
  enabledByDefault Boolean @default(true)
  sortOrder        Int     @default(100)

  /// Como se llama el apartado en este oficio: "Barberos" o "Empleados".
  labelOverride String?
  /// Ejemplo concreto en las palabras del oficio, para el configurador.
  example       String?

  @@unique([businessType, moduleKey])
  @@index([businessType])
}

/**
 * El espacio de trabajo de una persona.
 * Va por persona y no por negocio: al dueno le sirven reportes y proveedores,
 * y al que solo vende le estorban. Guarda llaves de modulo separadas por coma.
 * Lleva userId ademas de staffId por la misma razon que las lineas de venta:
 * el aislamiento vive en la fila y no depende de que la consulta se acuerde de
 * pasar por el padre.
 */
model WorkspaceConfig {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffId String @unique
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  /// Llaves apagadas. Las fijas se ignoran aunque alguien las mande.
  hiddenKeys String @default("")
  /// Orden elegido. Lo que no aparezca aqui se va al final, para que un
  /// apartado nuevo se estrene solo en vez de quedar invisible para siempre.
  orderKeys  String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/**
 * Cuando alguien abre un apartado.
 * Sirve para una sola cosa: poder decirle al cliente "llevas dos meses sin
 * abrir Proveedores, lo apago?" en vez de adivinar que le sobra.
 */
model ModuleEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffId   String?
  moduleKey String
  createdAt DateTime @default(now())

  @@index([userId, moduleKey])
  @@index([userId, createdAt])
}

/**
 * Lo que el administrador de la plataforma le prende o le apaga a UNA cuenta.
 * Es distinto del catalogo (que dice que le toca a cada oficio) y del espacio
 * de trabajo (que dice que quiso ver cada persona). Esto manda sobre los dos:
 * si aqui dice que no, el apartado no existe para esa cuenta y no hay boton
 * que lo devuelva desde adentro.
 * Sirve para dos cosas: apagarle a alguien algo que le esta dando problemas, y
 * dejar apagado lo que todavia no se le quiere dar a todo el mundo.
 */
model AccountModule {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleKey String
  module    Module @relation(fields: [moduleKey], references: [key], onDelete: Cascade)

  enabled Boolean
  /// Por que se toco. Es para acordarse en tres meses, no lo ve el cliente.
  note    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, moduleKey])
  @@index([userId])
}

/// Un enlace de un solo uso para reponer la contrasena que alguien olvido.
///
/// Existe esta tabla y no una columna en User porque el enlace tambien sirve
/// para los barberos (Staff), y porque hace falta guardar cuando vence y si ya
/// se uso: un enlace que sirva dos veces es un enlace que quedo suelto en el
/// correo de alguien.
model PasswordReset {
  id String @id @default(cuid())

  /// Huella del token que viaja en el enlace, no el token.
  ///
  /// Va con SHA-256 y no con bcrypt a proposito: el token lo generamos
  /// nosotros con 32 bytes al azar, asi que no hay nada que adivinar a fuerza
  /// bruta, y necesitamos poder buscarlo de una por su huella. Guardar el
  /// token tal cual seria dejar en la base la llave de todas las cuentas.
  tokenHash String @unique

  /// Correo al que se mando, en minusculas. Se guarda aparte de la cuenta para
  /// poder contar cuantos enlaces se pidieron aunque el correo no exista.
  email String

  /// A quien le repone la clave. Solo uno de los dos viene lleno.
  userId  String?
  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffId String?
  staff   Staff?  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  /// Hasta cuando sirve. Pasada esta hora el enlace no vale, aunque nadie lo
  /// haya usado.
  expiresAt DateTime

  /// Cuando se uso. Si esta puesto, el enlace ya no sirve.
  usedAt DateTime?

  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([expiresAt])
}

/// Entrada o salida de la jornada.
enum MarkKind {
  ENTRADA
  SALIDA
}

/// Donde se trabaja: una sede, un edificio, la obra de un cliente.
///
/// Tener coordenadas es opcional. Si las tiene, cada marcaje guarda a cuantos
/// metros quedo, y el que quedo lejos sale marcado. Nunca impide marcar: un
/// GPS impreciso o un sotano sin senal dejarian a la persona sin poder
/// registrar su jornada, y ese problema termina siendo del dueno.
model WorkSite {
  id      String  @id @default(cuid())
  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name    String
  address String?

  lat Float?
  lng Float?

  /// Radio en metros dentro del cual se considera que marco "en el sitio".
  radiusM Int @default(150)

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  marks   Attendance[]
  reports VisitReport[]

  @@index([userId, active])
}

/// Un marcaje de entrada o salida.
///
/// NO SE EDITA NI SE BORRA NUNCA. Es lo que le da valor: si se pudiera
/// cambiar la hora despues, no serviria de prueba ante un reclamo, que suele
/// ser justo el motivo de llevarlo. Un marcaje equivocado se anula con un
/// motivo escrito, y quedan los dos a la vista: el original y su anulacion,
/// como en un libro contable.
model Attendance {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Quien marco.
  staffId String
  staff   Staff  @relation("MarcajesDeLaPersona", fields: [staffId], references: [id], onDelete: Cascade)

  siteId String?
  site   WorkSite? @relation(fields: [siteId], references: [id], onDelete: SetNull)

  kind MarkKind

  /**
   * Dos relojes, a proposito.
   * `markedAt` es cuando la persona toco el boton, segun el reloj de su
   * telefono. `receivedAt` es cuando el marcaje llego al servidor. Cuando se
   * marca sin senal los dos se separan, y esa diferencia es justo lo que hay
   * que poder ver: dice que el registro viajo en la cola del telefono.
   */
  markedAt   DateTime
  receivedAt DateTime @default(now())

  /// Donde estaba. Puede faltar si nego el permiso o no habia senal de GPS.
  lat       Float?
  lng       Float?
  /// Cuanto se puede fiar uno de esa coordenada, en metros.
  accuracyM Int?
  /// Metros hasta el sitio, cuando el sitio tiene coordenadas.
  distanceM Int?

  /**
   * La llave que manda el telefono, unica por marcaje.
   * Es lo que impide que la cola duplique: si el envio se corta despues de
   * guardar pero antes de confirmar, el telefono reintenta y el servidor
   * reconoce que ese marcaje ya entro. Sin esto, una mala senal convierte una
   * entrada en cinco.
   */
  clientKey String @unique

  note String?

  /// Anulacion. El marcaje no se borra: se tacha y se dice por que.
  voidedAt        DateTime?
  voidedReason    String?
  voidedByStaffId String?

  createdAt DateTime @default(now())

  @@index([userId, markedAt])
  @@index([staffId, markedAt])
}

/// Reporte de una visita, con fotos, para mandarle al cliente.
model VisitReport {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  siteId String?
  site   WorkSite? @relation(fields: [siteId], references: [id], onDelete: SetNull)

  /// "YYYY-MM-DD" del dia del trabajo.
  day   String
  title String
  /// Que se hizo, en palabras.
  body  String?

  /// A quien se le manda. Se guarda suelto y no como relacion: el cliente de
  /// un reporte no siempre es una cuenta de la aplicacion.
  clientName  String?
  clientPhone String?

  createdByStaffId String?

  /// La llave que invento el telefono al guardar el reporte sin senal. Si el
  /// envio se corta y se reintenta, el servidor reconoce que ya lo tenia y no
  /// crea otro.
  clientKey String?   @unique
  /// Cuando quien lo hizo lo termino de subir con sus fotos: desde ahi le
  /// aparece al administrador como nuevo.
  sentAt    DateTime?
  /// Cuando el administrador lo abrio. El empleado ve que ya se lo miraron.
  seenAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photos VisitPhoto[]

  @@index([userId, day])
}

/// Una foto del reporte. Se guarda como data URL, igual que el logo.
model VisitPhoto {
  id       String      @id @default(cuid())
  userId   String
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  reportId String
  report   VisitReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  image   String
  caption String?
  sort    Int     @default(0)
  /// Llave del telefono para esta foto: reintentar la subida no la repite.
  clientKey String? @unique

  createdAt DateTime @default(now())

  @@index([reportId, sort])
}

/// Cada intento de responder la pregunta de seguridad.
///
/// Existe para frenar la fuerza bruta: una respuesta como "el nombre de tu
/// primera mascota" tiene pocas opciones, y sin tope alguien podria probar
/// cien seguidas. Se cuenta por correo y no por cuenta, para que tambien frene
/// a quien prueba correos que no existen.
model SecurityAttempt {
  id        String   @id @default(cuid())
  email     String
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

// ------------------------------------------------------------------ CRM

/// En que va una oportunidad de venta. Ver lib/crm.ts.
enum DealStage {
  NUEVO
  CONTACTADO
  PROPUESTA
  NEGOCIACION
  GANADO
  PERDIDO
}

/// Como se hablo con el cliente. NOTA es un apunte interno, no un contacto.
enum InteractionKind {
  NOTA
  LLAMADA
  WHATSAPP
  VISITA
  CORREO
  CHAT
}

/// La ficha unica del cliente.
///
/// Antes cada apartado guardaba su propio nombre y telefono suelto (el turno,
/// la deuda, la venta, el reporte), y la misma persona era cuatro personas.
/// Aqui queda una sola, y su historial se arma buscando esos registros por
/// telefono y por nombre (lib/clientes.ts). No se les agrego una columna
/// customerId a esas tablas a proposito: lo que ya esta guardado seguiria sin
/// ella, y el historial viejo es justo el que mas interesa ver.
model Customer {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name     String
  phone    String?
  /// Los ultimos diez digitos del telefono. Es con lo que se reconoce que dos
  /// registros son la misma persona aunque el numero se haya escrito distinto.
  phoneKey String?
  email    String?
  /// Cedula o NIT.
  document String?
  address  String?
  notes    String?
  /// De donde salio: manual, importado, reserva, turno, cartera, reporte, chat
  /// o whatsapp. Solo informativo.
  source   String  @default("manual")

  /// La ultima vez que alguien le hablo. Lo mueven las interacciones que son
  /// contacto, no las notas.
  lastContactAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags         CustomerTagLink[]
  deals        Deal[]
  followUps    FollowUp[]
  interactions Interaction[]
  agentConversations AgentConversation[]

  @@unique([userId, phoneKey])
  @@index([userId, name])
  @@index([userId, lastContactAt])
}

model CustomerTag {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String   @default("#2563eb")
  createdAt DateTime @default(now())

  links CustomerTagLink[]

  @@unique([userId, name])
}

model CustomerTagLink {
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tagId      String
  tag        CustomerTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  /// Repetido a proposito: toda consulta del CRM filtra por negocio, tambien
  /// esta.
  userId     String
  createdAt  DateTime    @default(now())

  @@id([customerId, tagId])
  @@index([userId, tagId])
}

/// Una oportunidad de venta: lo que este cliente podria comprar y en que va.
model Deal {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  title       String
  /// Cuanto vale, en unidades minimas de la moneda, igual que el resto.
  value       Int       @default(0)
  stage       DealStage @default(NUEVO)
  /// Quien la lleva.
  staffId     String?
  staff       Staff?    @relation("OportunidadesDeLaPersona", fields: [staffId], references: [id], onDelete: SetNull)
  /// Cuando se espera cerrar, "YYYY-MM-DD".
  expectedDay String?
  lostReason  String?
  /// Cuando paso a ganada o perdida. Vuelve a vacio si se reabre.
  closedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  followUps FollowUp[]

  @@index([userId, stage])
  @@index([customerId])
}

/// Algo que hay que hacer con un cliente en un dia: llamar, mandar la
/// cotizacion, pasar a cobrar.
model FollowUp {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  dealId      String?
  deal        Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)
  title       String
  /// "YYYY-MM-DD" en la zona del negocio, como el resto de fechas del dia.
  dueDay      String
  /// "HH:mm", opcional.
  dueTime     String?
  /// A quien le toca.
  staffId     String?
  staff       Staff?    @relation("SeguimientosDeLaPersona", fields: [staffId], references: [id], onDelete: SetNull)
  createdById String?
  doneAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, doneAt, dueDay])
  @@index([userId, staffId, doneAt])
  @@index([customerId])
}

/// Lo que paso con el cliente: una llamada, un WhatsApp, una visita, una nota.
model Interaction {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  kind       InteractionKind
  text       String
  staffId    String?
  /// Copia del nombre, por si la persona se borra: el historial no pierde autor.
  staffName  String?
  createdAt  DateTime        @default(now())

  @@index([customerId, createdAt])
  @@index([userId, createdAt])
}

// ------------------------------------------------------------ AGENTE IA

/// Lo que el dueño configura del agente que contesta solo.
model AgentConfig {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Contesta en el chat de la pagina publica.
  webOn      Boolean  @default(false)
  /// Contesta los WhatsApp que llegan al numero conectado con Meta.
  whatsappOn Boolean  @default(false)
  /// Lo primero que ve el cliente al abrir el chat.
  greeting   String?
  /// Lo que el agente debe saber y no esta en la aplicacion: domicilios,
  /// formas de pago, garantias, parqueadero.
  notes      String?
  updatedAt  DateTime @updatedAt
}

/// Una conversacion con alguien que le escribio al agente.
///
/// Se guarda en la base y no solo en el navegador por dos razones: WhatsApp no
/// tiene navegador donde guardarla, y el dueño tiene que poder leer que le
/// dijo el agente a sus clientes.
model AgentConversation {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "web", "whatsapp" o "prueba".
  channel       String
  /// Quien escribe: el numero en WhatsApp, o la llave que guarda el navegador.
  contactKey    String
  contactName   String?
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())

  messages AgentMessage[]

  @@unique([userId, channel, contactKey])
  @@index([userId, lastMessageAt])
}

model AgentMessage {
  id             String            @id @default(cuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// "cliente" o "agente".
  role           String
  text           String
  /// Lo que el agente hizo con este mensaje, si hizo algo: "Turno agendado...".
  action         String?
  /// El id del mensaje en WhatsApp. Meta reenvia el mismo mensaje si no le
  /// contestamos a tiempo; con esto no se responde dos veces.
  externalId     String?           @unique
  createdAt      DateTime          @default(now())

  @@index([conversationId, createdAt])
  @@index([userId, createdAt])
}

// ------------------------------------------------- NOVEDADES DEL PERSONAL

/// Que tipo de novedad avisa el empleado. Ver lib/novedades.ts.
enum NoveltyKind {
  PERMISO
  INCAPACIDAD
  CALAMIDAD
  LLEGADA_TARDE
  SALIDA_TEMPRANO
  VACACIONES
  OTRO
}

enum NoveltyStatus {
  PENDIENTE
  APROBADA
  RECHAZADA
}

/// Lo que un empleado le avisa al administrador y no es un marcaje: un
/// permiso, una incapacidad, que va a llegar tarde.
///
/// Va aparte de los marcajes a proposito: el marcaje es lo que paso y no se
/// toca; la novedad es una explicacion que el administrador aprueba o no.
model Novelty {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffId           String
  staff             Staff         @relation("NovedadesDeLaPersona", fields: [staffId], references: [id], onDelete: Cascade)
  kind              NoveltyKind
  /// Dias que cubre, "YYYY-MM-DD". Un permiso de una tarde es de un solo dia.
  fromDay           String
  toDay             String
  /// Horas, "HH:mm", solo si es por horas (permiso, llegada tarde).
  fromTime          String?
  toTime            String?
  reason            String
  /// Foto del soporte (la incapacidad, la cita), como data URL.
  photo             String?
  status            NoveltyStatus @default(PENDIENTE)
  /// Llave del telefono: la novedad se puede avisar sin senal.
  clientKey         String?       @unique
  reviewedAt        DateTime?
  reviewedByStaffId String?
  reviewNote        String?
  createdAt         DateTime      @default(now())

  @@index([userId, status])
  @@index([staffId, fromDay])
}
