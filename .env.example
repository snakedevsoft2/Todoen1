# --- Base de datos ---
# En tu computador con Docker (npm run db:up):
DATABASE_URL="postgresql://postgres:devpass@localhost:55432/todoenuno?schema=public"
# En Vercel usa la cadena de Neon, Supabase o Vercel Postgres, por ejemplo:
# DATABASE_URL="postgresql://usuario:password@host/db?sslmode=require"

# --- Sesion ---
# Cadena larga y aleatoria. Generala con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria"

# --- Panel de la plataforma ---
# Tu correo (o varios separados por coma). Quien entre con uno de estos ve
# /admin: cuentas registradas, quien sigue entrando y que apagarle a cada uno.
#
# Va aqui y no en la base de datos a proposito: asi ninguna pantalla y ninguna
# consulta puede volver administrador a nadie. Si esta vacio, no hay
# administrador y el panel no existe para nadie.
ADMIN_EMAILS=""

# --- Recordatorios automaticos ---
# Clave que protege /api/recordatorios para que nadie de afuera dispare envios.
# Generala igual que AUTH_SECRET:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# En Vercel, el archivo vercel.json llama esa direccion todos los dias a las
# 14:00 UTC (9:00 am en Colombia) y manda los recordatorios de las citas de
# manana y los cobros de cartera vencida. Sin esta clave el endpoint responde
# error a proposito y no manda nada.
CRON_SECRET=""

# --- Asistente con IA (opcional) ---
# Llave gratis de Google AI Studio: https://aistudio.google.com/apikey
# Si esta vacia, el apartado Asistente no aparece en el menu de nadie.
GEMINI_API_KEY=""
