# --- Base de datos ---
# En tu computador con Docker (npm run db:up):
DATABASE_URL="postgresql://postgres:devpass@localhost:55432/todoenuno?schema=public"
# En Vercel usa la cadena de Neon, Supabase o Vercel Postgres, por ejemplo:
# DATABASE_URL="postgresql://usuario:password@host/db?sslmode=require"

# --- Sesion ---
# Cadena larga y aleatoria. Generala con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria"

# --- Panel de la plataforma ---
# Tu correo (o varios separados por coma). Quien entre con uno de estos ve
# /admin: cuentas registradas, quien sigue entrando y que apagarle a cada uno.
#
# Va aqui y no en la base de datos a proposito: asi ninguna pantalla y ninguna
# consulta puede volver administrador a nadie. Si esta vacio, no hay
# administrador y el panel no existe para nadie.
ADMIN_EMAILS=""
